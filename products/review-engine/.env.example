# Twilio credentials — https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Google Business Profile place ID for review link generation
# Find yours: search your business on Google Maps, the place ID is in the URL
# Or use the GBP Audit tool to look it up

# Server config
PORT=3001
HOST=localhost

# Optional: Anthropic API key for AI-generated review responses
ANTHROPIC_API_KEY=your_anthropic_key_here

# SQLite database path (auto-created)
DB_PATH=./data/review-engine.db
